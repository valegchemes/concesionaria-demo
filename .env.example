# =============================================================================
# ENTORNO DE PRODUCCIÓN - Copiar a .env.production y completar valores reales
# NUNCA commitear .env.production (está en .gitignore)
# =============================================================================

# -----------------------------------------------------------------------------
# BASE DE DATOS (PostgreSQL / Supabase / Neon)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@db:5432/concesionaria?schema=public
DIRECT_URL=postgresql://user:password@db:5432/concesionaria?schema=public

# -----------------------------------------------------------------------------
# NEXTAUTH (Autenticación)
# Generar con: openssl rand -base64 32
# -----------------------------------------------------------------------------
NEXTAUTH_SECRET=your-super-secret-key-min-32-chars-generated-with-openssl
NEXTAUTH_URL=https://tu-dominio.com

# -----------------------------------------------------------------------------
# SUPABASE (Storage público catálogo)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# -----------------------------------------------------------------------------
# VERCEL BLOB (Subida de imágenes)
# -----------------------------------------------------------------------------
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_token

# -----------------------------------------------------------------------------
# MERCADO PAGO (Pagos / Suscripciones)
# -----------------------------------------------------------------------------
MP_ACCESS_TOKEN=APP_USR-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MP_PUBLIC_KEY=APP_USR-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MP_WEBHOOK_SECRET=your-webhook-secret-from-mercadopago

# -----------------------------------------------------------------------------
# GOOGLE OAUTH (Gmail API para Email AI)
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# -----------------------------------------------------------------------------
# GEMINI AI (Auto-responder emails)
# -----------------------------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key

# -----------------------------------------------------------------------------
# AGENTE IA COPILOT (Chat interno multi-proveedor)
# Elegí UN proveedor activo con AI_PROVIDER:
#   - "nvidia"    → NVIDIA NIM (recomendado, gratuito, muy rápido)
#                  Registrate en: https://build.nvidia.com
#   - "openai"    → OpenAI GPT-4o
#                  Registrate en: https://platform.openai.com
#   - "anthropic" → Anthropic Claude 3.5 Sonnet
#                  Registrate en: https://console.anthropic.com
# -----------------------------------------------------------------------------
AI_PROVIDER=nvidia
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# CRON JOBS (Seguridad)
# Generar con: openssl rand -base64 32
# -----------------------------------------------------------------------------
CRON_SECRET=your-cron-secret-min-32-chars

# -----------------------------------------------------------------------------
# DIAGNÓSTICO (Endpoint interno)
# Generar con: openssl rand -base64 32
# -----------------------------------------------------------------------------
DIAG_SECRET_TOKEN=your-diag-secret-min-32-chars

# -----------------------------------------------------------------------------
# REDIS / KV (Rate limiting - Upstash / Vercel KV)
# -----------------------------------------------------------------------------
KV_URL=redis://default:password@host:port
KV_REST_API_URL=https://your-kv.rest.upstash.io
KV_REST_API_TOKEN=your-kv-rest-token
# Alternativa Upstash:
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# -----------------------------------------------------------------------------
# PUSHER (WebSockets tiempo real)
# -----------------------------------------------------------------------------
PUSHER_APP_ID=your-pusher-app-id
PUSHER_KEY=your-pusher-key
PUSHER_SECRET=your-pusher-secret
PUSHER_CLUSTER=mt1
NEXT_PUBLIC_PUSHER_KEY=your-pusher-key
NEXT_PUBLIC_PUSHER_CLUSTER=mt1

# -----------------------------------------------------------------------------
# SENTRY (Monitoreo errores)
# -----------------------------------------------------------------------------
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=your-sentry-project

# -----------------------------------------------------------------------------
# DOCUMENTOS PÚBLICOS (Tokens de acceso JWT)
# Generar con: openssl rand -base64 32
# -----------------------------------------------------------------------------
DOC_ACCESS_SECRET=your-doc-access-secret-min-32-chars

# -----------------------------------------------------------------------------
# GMAIL ENCRYPTION (Cifrado tokens OAuth en BD)
# Generar con: openssl rand -base64 32
# -----------------------------------------------------------------------------
GMAIL_ENCRYPTION_KEY=your-gmail-encryption-key-32-bytes-base64

# -----------------------------------------------------------------------------
# DESARROLLADOR (Emails con acceso ilimitado — separados por comas)
# -----------------------------------------------------------------------------
DEVELOPER_EMAILS=valegchemes@gmail.com,banigale.info@gmail.com

# -----------------------------------------------------------------------------
# TIPO DE CAMBIO (ARS/USD por defecto)
# -----------------------------------------------------------------------------
DEFAULT_EXCHANGE_RATE_ARS_PER_USD=1000

# -----------------------------------------------------------------------------
# URL PÚBLICA (Para emails, webhooks, etc.)
# -----------------------------------------------------------------------------
PUBLIC_URL=https://tu-dominio.com

# -----------------------------------------------------------------------------
# Configuración del Agente IA Copilot
# -----------------------------------------------------------------------------
AI_PROVIDER="nvidia"
NVIDIA_API_KEY="tu-api-key-de-nvidia"
OPENAI_API_KEY="tu-api-key-de-openai-opcional"
ANTHROPIC_API_KEY="tu-api-key-de-anthropic-opcional"
# -----------------------------------------------------------------------------
# NODE ENV
# -----------------------------------------------------------------------------
NODE_ENV=production