generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Company {
  id                      String                    @id @default(cuid())
  name                    String
  slug                    String                    @unique
  customDomain            String?                   @unique
  email                   String
  phone                   String?
  whatsappCentral         String?
  address                 String?
  city                    String?
  logoUrl                 String?
  currencyPreference      String                    @default("BOTH")
  isActive                Boolean                   @default(true)
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  cuit                    String?
  signatureUrl            String?
  auditLogs               AuditLog[]
  cashSessions            CashSession[]
  cashTransactions        CashTransaction[]
  expenses                CompanyExpense[]
  customVehicleDictionary CustomVehicleDictionary[]
  deals                   Deal[]
  digitalDocuments        DigitalDocument[]
  emailInteractions       EmailInteraction[]
  gmailConnection         GmailConnection?
  leads                   Lead[]
  promissoryNotes         PromissoryNote[]
  publicClickEvents       PublicClickEvent[]
  roles                   Role[]
  subscription            SaasSubscription?
  units                   Unit[]
  users                   User[]
  whatsappTemplates       WhatsAppTemplate[]

  @@map("Company")
}

model User {
  id                    String         @id @default(cuid())
  email                 String
  name                  String
  password              String
  role                  UserRole       @default(SELLER)
  isActive              Boolean        @default(true)
  whatsappNumber        String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  companyId             String
  avatarUrl             String?
  exchangeRateArsPerUsd Decimal?       @db.Decimal(12, 4)
  commissionRate        Decimal        @default(0) @db.Decimal(5, 2)
  auditLogs             AuditLog[]
  cashSessions          CashSession[]
  deals                 Deal[]
  assignedLeads         Lead[]         @relation("AssignedLeads")
  createdLeads          Lead[]         @relation("CreatedLeads")
  activities            LeadActivity[]
  tasks                 Task[]         @relation("AssignedTasks")
  createdUnits          Unit[]         @relation("CreatedUnits")
  company               Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customRoles           Role[]         @relation("UserRoles")

  @@unique([email, companyId])
  @@index([companyId])
  @@index([companyId, isActive])
  @@index([companyId, role])
  @@map("User")
}

model Lead {
  id               String            @id @default(cuid())
  name             String
  phone            String
  email            String?
  source           LeadSource        @default(OTHER)
  status           LeadStatus        @default(NEW)
  lostReason       String?
  notes            String?
  quickInfo        String?
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  companyId        String
  assignedToId     String?
  createdById      String
  interestedUnitId String?
  deals            Deal[]
  digitalDocuments DigitalDocument[]
  assignedTo       User?             @relation("AssignedLeads", fields: [assignedToId], references: [id])
  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy        User              @relation("CreatedLeads", fields: [createdById], references: [id])
  interestedUnit   Unit?             @relation("LeadInterestedUnit", fields: [interestedUnitId], references: [id])
  activities       LeadActivity[]
  promissoryNotes  PromissoryNote[]
  tasks            Task[]

  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, assignedToId])
  @@index([companyId, status, assignedToId])
  @@index([companyId, createdAt(sort: Desc)])
  @@index([companyId, isActive])
  @@index([phone])
  @@index([email])
  @@map("Lead")
}

model LeadActivity {
  id          String       @id @default(cuid())
  type        ActivityType
  notes       String?
  createdAt   DateTime     @default(now())
  leadId      String
  createdById String
  companyId   String
  createdBy   User         @relation(fields: [createdById], references: [id])
  lead        Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([companyId])
  @@map("LeadActivity")
}

model Task {
  id           String    @id @default(cuid())
  title        String
  description  String?
  dueDate      DateTime
  isCompleted  Boolean   @default(false)
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  leadId       String
  assignedToId String
  companyId    String
  assignedTo   User      @relation("AssignedTasks", fields: [assignedToId], references: [id])
  lead         Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([companyId])
  @@index([assignedToId, isCompleted])
  @@map("Task")
}

model Unit {
  id                 String            @id @default(cuid())
  type               UnitType
  title              String
  description        String?
  status             UnitStatus        @default(AVAILABLE)
  location           String?
  tags               String[]
  isActive           Boolean           @default(true)
  priceArs           Decimal?          @db.Decimal(12, 2)
  priceUsd           Decimal?          @db.Decimal(12, 2)
  vin                String?
  domain             String?
  engineNumber       String?
  frameNumber        String?
  hin                String?
  registrationNumber String?
  acquisitionCostArs Decimal?          @db.Decimal(12, 2)
  acquisitionCostUsd Decimal?          @db.Decimal(12, 2)
  acquisitionType    AcquisitionType   @default(PURCHASE)
  acquisitionDate    DateTime?
  isFromTradeIn      Boolean           @default(false)
  tradeInId          String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  companyId          String
  year               Int?
  createdById        String?
  deals              Deal[]
  digitalDocuments   DigitalDocument[]
  interestedLeads    Lead[]            @relation("LeadInterestedUnit")
  promissoryNotes    PromissoryNote[]
  company            Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy          User?             @relation("CreatedUnits", fields: [createdById], references: [id])
  attributes         UnitAttribute[]
  costItems          UnitCostItem[]
  photos             UnitPhoto[]

  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, type])
  @@index([companyId, status, type])
  @@index([companyId, priceArs])
  @@index([companyId, createdAt(sort: Desc)])
  @@index([companyId, isActive])
  @@map("Unit")
}

model UnitPhoto {
  id        String   @id @default(cuid())
  url       String
  order     Int      @default(0)
  caption   String?
  createdAt DateTime @default(now())
  unitId    String
  unit      Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@index([unitId])
  @@map("UnitPhoto")
}

model UnitAttribute {
  id     String @id @default(cuid())
  key    String
  value  String
  unitId String
  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@unique([unitId, key])
  @@index([unitId])
  @@map("UnitAttribute")
}

model UnitCostItem {
  id        String   @id @default(cuid())
  concept   String
  amountArs Decimal? @db.Decimal(12, 2)
  amountUsd Decimal? @db.Decimal(12, 2)
  date      DateTime @default(now())
  unitId    String
  unit      Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@index([unitId])
  @@map("UnitCostItem")
}

model PromissoryNote {
  id           String        @id @default(cuid())
  amount       Decimal       @db.Decimal(12, 2)
  issueDate    DateTime
  dueDate      DateTime
  notes        String?
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  unitId       String
  companyId    String
  leadId       String
  currency     Currency      @default(ARS)
  installments Installment[]
  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lead         Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  unit         Unit          @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@index([unitId])
  @@index([companyId])
  @@index([companyId, dueDate])
  @@map("PromissoryNote")
}

model Installment {
  id                String               @id @default(cuid())
  installmentNumber Int
  amount            Decimal              @db.Decimal(12, 2)
  dueDate           DateTime
  status            InstallmentStatus    @default(PENDING)
  notes             String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  promissoryNoteId  String
  promissoryNote    PromissoryNote       @relation(fields: [promissoryNoteId], references: [id], onDelete: Cascade)
  payments          InstallmentPayment[]

  @@index([promissoryNoteId])
  @@index([dueDate, status])
  @@index([status, dueDate])
  @@map("Installment")
}

model InstallmentPayment {
  id            String        @id @default(cuid())
  amount        Decimal       @db.Decimal(12, 2)
  date          DateTime      @default(now())
  notes         String?
  createdAt     DateTime      @default(now())
  installmentId String
  method        PaymentMethod @default(CASH)
  installment   Installment   @relation(fields: [installmentId], references: [id], onDelete: Cascade)

  @@index([installmentId])
  @@map("InstallmentPayment")
}

model Deal {
  id                 String         @id @default(cuid())
  status             DealStatus     @default(NEGOTIATION)
  finalPrice         Decimal        @db.Decimal(12, 2)
  finalPriceCurrency String         @default("ARS")
  exchangeRate       Decimal?       @db.Decimal(10, 4)
  depositAmount      Decimal?       @db.Decimal(12, 2)
  depositDate        DateTime?
  depositMethod      PaymentMethod?
  commissionType     CommissionType @default(PERCENTAGE)
  commissionValue    Decimal        @default(0) @db.Decimal(10, 2)
  notes              String?
  closedAt           DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  companyId          String
  leadId             String
  unitId             String
  sellerId           String
  company            Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lead               Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  seller             User           @relation(fields: [sellerId], references: [id])
  unit               Unit           @relation(fields: [unitId], references: [id], onDelete: Cascade)
  closingCosts       DealCostItem[]
  payments           DealPayment[]
  tradeIn            TradeIn?

  @@index([companyId])
  @@index([companyId, status])
  @@index([sellerId])
  @@index([companyId, status, sellerId])
  @@index([companyId, createdAt(sort: Desc)])
  @@index([leadId])
  @@index([unitId])
  @@map("Deal")
}

model DealPayment {
  id         String        @id @default(cuid())
  amount     Decimal       @db.Decimal(12, 2)
  currency   Currency      @default(ARS)
  method     PaymentMethod @default(CASH)
  receivedAt DateTime      @default(now())
  notes      String?
  createdAt  DateTime      @default(now())
  dealId     String
  deal       Deal          @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId])
  @@map("DealPayment")
}

model DealCostItem {
  id        String   @id @default(cuid())
  concept   String
  amountArs Decimal? @db.Decimal(12, 2)
  amountUsd Decimal? @db.Decimal(12, 2)
  dealId    String
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId])
  @@map("DealCostItem")
}

model TradeIn {
  id                String    @id @default(cuid())
  description       String
  expectedValue     Decimal   @db.Decimal(12, 2)
  offeredValue      Decimal   @db.Decimal(12, 2)
  finalValue        Decimal   @db.Decimal(12, 2)
  convertedToUnitId String?   @unique
  isConverted       Boolean   @default(false)
  convertedAt       DateTime?
  dealId            String    @unique
  deal              Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@map("TradeIn")
}

model WhatsAppTemplate {
  id        String   @id @default(cuid())
  name      String
  template  String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, name])
  @@index([companyId])
  @@map("WhatsAppTemplate")
}

model PublicClickEvent {
  id        String    @id @default(cuid())
  type      ClickType
  unitId    String?
  metadata  String?
  ipHash    String?   // HMAC-SHA256 de la IP (anonymized para GDPR)
  userAgent String?
  createdAt DateTime  @default(now())
  companyId String
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([companyId, type])
  @@map("PublicClickEvent")
}

///
model AuditLog {
  id         String   @id @default(cuid())
  action     String   @db.VarChar(50)
  resource   String   @db.VarChar(100)
  resourceId String?
  before     Json?
  after      Json?
  ipAddress  String?
  userAgent  String?
  reason     String?
  createdAt  DateTime @default(now())
  companyId  String
  userId     String?
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id])

  @@index([companyId, createdAt])
  @@index([userId, createdAt])
  @@index([resource, resourceId])
  @@index([companyId, resource, createdAt])
  @@index([companyId, userId, createdAt])
  @@map("AuditLog")
}

///
model Role {
  id          String           @id @default(cuid())
  name        String
  description String?
  isDefault   Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  companyId   String?
  company     Company?         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  users       User[]           @relation("UserRoles")

  @@unique([name, companyId])
  @@index([companyId])
  @@map("Role")
}

///
model Permission {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  resource    String
  action      String
  createdAt   DateTime         @default(now())
  roles       RolePermission[]

  @@unique([resource, action])
  @@index([resource])
  @@map("Permission")
}

///
model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@map("RolePermission")
}

model SaasPlan {
  id               String             @id @default(cuid())
  name             String
  description      String?
  stripeProductId  String             @unique
  stripePriceId    String             @unique
  price            Decimal            @db.Decimal(10, 2)
  currency         String             @default("usd")
  interval         String             @default("month")
  isActive         Boolean            @default(true)
  maxUsers         Int                @default(0)
  maxUnits         Int                @default(0)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  analyticsEnabled Boolean            @default(false)
  whatsappEnabled  Boolean            @default(false)
  documentsEnabled Boolean            @default(false)
  auditEnabled     Boolean            @default(false)
  subscriptions    SaasSubscription[]

  @@map("SaasPlan")
}

model SaasSubscription {
  id                 String             @id @default(cuid())
  companyId          String             @unique
  planId             String?
  status             SubscriptionStatus @default(INCOMPLETE)
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean            @default(false)
  canceledAt         DateTime?
  trialEndsAt        DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  mpPaymentId        String?
  company            Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plan               SaasPlan?          @relation(fields: [planId], references: [id])

  @@index([companyId])
  @@index([mpPaymentId])
  @@map("SaasSubscription")
}

model SaasUsageEvent {
  id        String   @id @default(cuid())
  companyId String
  event     String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())

  @@index([companyId])
  @@map("SaasUsageEvent")
}

model CompanyExpense {
  id          String   @id @default(cuid())
  companyId   String
  category    String
  description String?
  amountArs   Decimal  @default(0)
  amountUsd   Decimal  @default(0)
  date        DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  isActive    Boolean  @default(true)
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, date])
  @@index([companyId, isActive])
  @@map("CompanyExpense")
}

model DigitalDocument {
  id              String         @id @default(cuid())
  type            DocumentType
  referenceNumber String?
  amount          Decimal?       @db.Decimal(12, 2)
  status          DocumentStatus @default(GENERATED)
  metadata        Json
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  unitId          String
  leadId          String
  companyId       String
  company         Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lead            Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  unit            Unit           @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([unitId])
  @@index([leadId])
  @@map("DigitalDocument")
}

model WebhookEvent {
  id          String    @id @default(cuid())
  eventId     String    @unique
  source      String
  type        String
  status      String    @default("processing")
  payload     Json?
  error       String?
  processedAt DateTime?
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  receivedAt  DateTime  @default(now())

  @@index([eventId])
  @@index([expiresAt])
  @@index([source, status])
  @@index([status, receivedAt])
  @@map("WebhookEvent")
}

model CustomVehicleDictionary {
  id        String   @id @default(cuid())
  brand     String
  model     String
  companyId String
  createdAt DateTime @default(now())
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, brand, model])
  @@index([companyId])
  @@map("CustomVehicleDictionary")
}

model CashSession {
  id             String            @id @default(cuid())
  companyId      String
  userId         String
  openedAt       DateTime          @default(now())
  closedAt       DateTime?
  openingBalance Decimal           @db.Decimal(12, 2)
  closingBalance Decimal?          @db.Decimal(12, 2)
  actualBalance  Decimal?          @db.Decimal(12, 2)
  status         CashSessionStatus @default(OPEN)
  notes          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  company        Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user           User              @relation(fields: [userId], references: [id])
  transactions   CashTransaction[]

  @@index([companyId])
  @@index([userId])
  @@map("CashSession")
}

model CashTransaction {
  id            String              @id @default(cuid())
  companyId     String
  sessionId     String
  type          CashTransactionType
  amount        Decimal             @db.Decimal(12, 2)
  currency      Currency            @default(ARS)
  concept       String
  referenceId   String?
  referenceType String?
  createdAt     DateTime            @default(now())
  company       Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  session       CashSession         @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([sessionId])
  @@map("CashTransaction")
}

model GmailConnection {
  id           String   @id @default(cuid())
  companyId    String   @unique
  emailAddress String
  accessTokenEnc  String?
  refreshTokenEnc String?
  tokenExpiry  DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("GmailConnection")
}

model EmailInteraction {
  id           String   @id @default(cuid())
  companyId    String
  fromEmail    String
  toEmail      String
  subject      String
  messageBodyEnc  String?  // AES-256-GCM encrypted
  replyBodyEnc    String?  // AES-256-GCM encrypted
  createdAt    DateTime @default(now())
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("EmailInteraction")
}

enum InstallmentStatus {
  PENDING
  PAID
  OVERDUE
}

enum UserRole {
  ADMIN
  MANAGER
  SELLER
}

enum Currency {
  ARS
  USD
}

enum LeadSource {
  INSTAGRAM
  FACEBOOK_MARKETPLACE
  REFERRAL
  WALK_IN
  PHONE
  WEBSITE
  WHATSAPP
  OLX
  AUTOSUSADOS
  OTHER
}

enum LeadStatus {
  NEW
  CONTACTED
  VISIT_SCHEDULED
  OFFER
  RESERVED
  SOLD
  LOST
}

enum ActivityType {
  WHATSAPP_SENT
  CALL_MADE
  CALL_RECEIVED
  VISIT_DONE
  OFFER_RECEIVED
  EMAIL_SENT
  NOTE_ADDED
  STATUS_CHANGED
  TASK_COMPLETED
}

enum UnitType {
  CAR
  MOTORCYCLE
  BOAT
}

enum UnitStatus {
  AVAILABLE
  IN_PREP
  RESERVED
  SOLD
}

enum AcquisitionType {
  PURCHASE
  TRADE_IN
  CONSIGNMENT
}

enum DealStatus {
  NEGOTIATION
  RESERVED
  APPROVED
  IN_PAYMENT
  DELIVERED
  CANCELED
}

enum CommissionType {
  PERCENTAGE
  FIXED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CHECK
  CREDIT_CARD
  FINANCING
  CRYPTO
  OTHER
}

enum ClickType {
  WHATSAPP_CLICK
  PHONE_CLICK
  UNIT_VIEW
  SHARE_CLICK
}

enum SubscriptionStatus {
  INCOMPLETE
  INCOMPLETE_EXPIRED
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
  PAUSED
}

enum DocumentType {
  BOLETO_COMPRAVENTA
  RECIBO
  CONTRATO
}

enum DocumentStatus {
  DRAFT
  GENERATED
  SIGNED
}

enum CashSessionStatus {
  OPEN
  CLOSED
}

enum CashTransactionType {
  INFLOW
  OUTFLOW
}
