{
  "framework": "nextjs",
  "installCommand": "npm install --legacy-peer-deps && npx prisma generate",
  "buildCommand": "next build",
  "crons": [
    {
      "path": "/api/cron/check-installments",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/deactivate-companies",
      "schedule": "0 3 * * *"
    }
  ]
}
