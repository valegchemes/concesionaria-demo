    "framer-motion": "^12.38.0",
    "googleapis": "^171.4.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.400.0",
    "mercadopago": "^2.12.1",
    "next": "^16.2.6",
